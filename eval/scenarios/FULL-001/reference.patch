@@ -0,0 +1,21 @@
+import { Head } from '@inertiajs/react';
+
+type Item = { id: number; title: string; body: string; date: string };
+
+export default function Announcements({ announcements }: { announcements: { data: Item[] } }) {
+    return (
+        <>
+            <Head title="お知らせ" />
+            <div className="p-4">
+                {announcements.data.length === 0 && <p>お知らせはありません</p>}
+                {announcements.data.map((a) => (
+                    <article key={a.id} className="mb-4">
+                        <h2>{a.title}</h2>
+                        <p>{a.date}</p>
+                        <p className="whitespace-pre-line">{a.body}</p>
+                    </article>
+                ))}
+            </div>
+        </>
+    );
+}
