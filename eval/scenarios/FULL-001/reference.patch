@@ -6,3 +6,20 @@
 Artisan::command('inspire', function () {
     $this->comment(Inspiring::quote());
 })->purpose('Display an inspiring quote');
+
+Artisan::command('announcement:create {title} {body}', function (string $title, string $body) {
+    $v = Illuminate\Support\Facades\Validator::make(
+        ['title' => $title, 'body' => $body],
+        ['title' => 'required|max:100', 'body' => 'required|max:2000'],
+    );
+    if ($v->fails()) {
+        foreach ($v->errors()->all() as $e) {
+            $this->error($e);
+        }
+
+        return 1;
+    }
+    App\Models\Announcement::create(['title' => $title, 'body' => $body]);
+
+    return 0;
+});
