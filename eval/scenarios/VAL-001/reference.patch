@@ -0,0 +1,38 @@
+import { Head } from '@inertiajs/react';
+import Heading from '@/components/heading';
+
+type Entry = { id: number; loggedInAt: string; ipAddress: string | null };
+
+export default function LoginHistory({ entries }: { entries: Entry[] }) {
+    return (
+        <>
+            <Head title="ログイン履歴" />
+
+            <div className="space-y-6">
+                <Heading
+                    variant="small"
+                    title="ログイン履歴"
+                    description="最近のログイン（新しい順に10件）"
+                />
+                {entries.length === 0 ? (
+                    <p className="text-sm text-muted-foreground">
+                        ログイン履歴はありません
+                    </p>
+                ) : (
+                    <ul className="divide-y text-sm">
+                        {entries.map((e) => (
+                            <li key={e.id} className="flex gap-4 py-2">
+                                <span>{e.loggedInAt}</span>
+                                <span>{e.ipAddress}</span>
+                            </li>
+                        ))}
+                    </ul>
+                )}
+            </div>
+        </>
+    );
+}
+
+LoginHistory.layout = {
+    breadcrumbs: [{ title: 'ログイン履歴', href: '/settings/login-history' }],
+};
