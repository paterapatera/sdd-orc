{
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net tests/",
    "eval:prepare": "deno run --allow-read --allow-write --allow-run=git --allow-env eval/prepare.ts",
    "eval:grade": "deno run --allow-read --allow-write --allow-run --allow-env eval/grade.ts",
    "eval:summary": "deno run --allow-read --allow-env eval/summary.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve",
    "exclude": [
      "tests/fixtures/",
      "**/*.md",
      ".agents/**/*.md"
    ]
  },
  "lint": {
    "exclude": [
      "tests/fixtures/"
    ]
  },
  "exclude": [
    ".sdd/",
    "eval/runs/"
  ]
}
